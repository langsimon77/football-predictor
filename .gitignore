# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Third-party raw and intermediate data stay out of Git (PRD item 25).
data/raw/
data/interim/

# Local secrets
.env

# macOS
.DS_Store

# Derived data: rebuilt from data/raw by `make data` (PRD item 25).
data/processed/

# Last good Bayesian posteriors: carried between runs by the Actions cache.
data/posteriors/

# Dashboard files are rebuilt by every daily run and published with the static
# page; only the slowly growing ratings history is committed (PRD item 25).
app/data/*
!app/data/ratings_history.csv
!app/data/backtest.parquet
site/
