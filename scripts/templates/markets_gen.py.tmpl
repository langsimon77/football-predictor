"""Generated by scripts/gen_markets.py from data/markets/markets.json. Do not edit."""
from __future__ import annotations

import operator

MARKETS: dict[str, dict] = __MARKETS__

_OPS = {">": operator.gt, ">=": operator.ge, "<": operator.lt, "<=": operator.le,
        "==": operator.eq, "!=": operator.ne}


def stats(score: dict) -> dict:
    """score: hg, ag (90 minutes), and optionally corners and yellows (match totals)."""
    hg, ag = score.get("hg"), score.get("ag")
    out = {"corners": score.get("corners"), "yellows": score.get("yellows")}
    if hg is not None and ag is not None:
        out.update(diff=hg - ag, total=hg + ag, both=1 if hg > 0 and ag > 0 else 0)
    return out


def _holds(rule: list, s: dict) -> bool | None:
    v = s.get(rule[0])
    return None if v is None else _OPS[rule[1]](v, rule[2])


def settle(code: str, score: dict) -> str | None:
    """won, lost or void; None when a statistic the pick needs is missing."""
    m, s = MARKETS[code], stats(score)
    if "void" in m:
        v = _holds(m["void"], s)
        if v is None:
            return None
        if v:
            return "void"
    w = _holds(m["win"], s)
    return None if w is None else ("won" if w else "lost")


def label(code: str, home: str, away: str) -> str:
    return MARKETS[code]["label"].replace("{home}", home).replace("{away}", away)
